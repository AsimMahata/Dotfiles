{
    "position": "top",
    "height": 2,
    "modules-left": [
        "custom/app",
        "hyprland/language",
        "hyprland/window",
        "custom/island"
    ],
    "modules-center": [
        "hyprland/workspaces"
    ],
    "modules-right": [
        "tray",
        "privacy",
        "group/hardware",
        "group/connectivity",
        "pulseaudio",
        "group/power",
        "custom/notifications",
        "clock",
        "custom/power"
    ],
    "custom/app": {
        "on-click": "pkill rofi || .config/rofi/launchers/launcher.sh",
        "format": "{icon}   App",
        "format-icons": {
            "default": ""
        }
    },
    "custom/island": {
        "exec": "python3 ~/.config/waybar/scripts/island/dynamic-island.py",
        "return-type": "json",
        "restart-interval": 1,
        "on-click": "pkill -SIGUSR1 -f dynamic-island.py",
        "on-click-right": "pkill -SIGUSR2 -f dynamic-island.py",
        "on-click-middle": "~/.config/waybar/scripts/island/island-settings-toggle.sh",
        "tooltip": true
    },
    "custom/mic": {
        "format": "",
        "on-click": "qs toggle mic"
    },
    "hyprland/language": {
        "format": "{short}"
    },
    "hyprland/window": {
        "format": "{}",
        "max-length": 25,
        "rewrite": {
            "(.*) .* Brave": "󰦝  $1",
            "^nvim(.*)": "   $1",
            "Neovide": "    Neovide",
            "Qalculate!": "    Qalculate"
        },
        "separate-outputs": true
    },
    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "all-outputs": true,
        "format-icons": {
            "default": " ",
            "active": " "
        }
    },
    "privacy": {
        "icon-spacing": 4,
        "icon-size": 15,
        "transition-duration": 250,
        "modules": [
            {
                "type": "screenshare",
                "tooltip": true,
                "tooltip-icon-size": 24
            },
            // {
            //     "type": "audio-out",
            //     "tooltip": true,
            //     "tooltip-icon-size": 24
            // },
            {
                "type": "audio-in",
                "tooltip": true,
                "tooltip-icon-size": 24
            }
        ],
        "ignore-monitor": true,
        "ignore": [
            {
                "type": "audio-in",
                "name": "cava"
            },
            {
                "type": "screenshare",
                "name": "obs"
            }
        ]
    },
    "custom/power": {
        "format": "⏻",
        "tooltip": "Power menu",
        "on-click": "wlogout",
        "on-click-right": "pkill wlogout"
    },
    "custom/notifications": {
        "format": "{icon}",
        "format-icons": {
            "default": "󰂚", // Bell icon (no notifications)
            "notification": "󰂞", // Bell with dot (has notifications)
            "dnd": "󰂛" // Bell with slash (Do Not Disturb)
        },
        "tooltip": false,
        "on-click": "swaync-client -t",
        "on-click-right": "swaync-client -d", // Toggle DND mode
        "escape": true
    },
    "clock": {
        "format": "<span>   </span>{:%a %d %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "<span size='13000' foreground='#a6e3a1'>{icon} </span> {capacity}%",
        "format-warning": "<span size='13000' foreground='#B1E3AD'>{icon} </span> {capacity}%",
        "format-critical": "<span size='13000' foreground='#E38C8F'>{icon} </span> {capacity}%",
        "format-charging": "<span size='13000' foreground='#B1E3AD'> </span>{capacity}%",
        "format-plugged": "<span size='13000' foreground='#B1E3AD'> </span>{capacity}%",
        "format-alt": "<span size='13000' foreground='#B1E3AD'>{icon} </span> {time}",
        "format-full": "<span size='13000' foreground='#B1E3AD'> </span>{capacity}%",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ],
        "tooltip-format": "{time}",
        "on-click": "~/.config/waybar/scripts/sliders/brightness-toggle.sh"
    },
    "custom/power-profile": {
        "format": "{icon}",
        "tooltip": true,
        "return-type": "json",
        "exec": "~/.config/waybar/scripts/power/power-profile-status.sh",
        "on-click": "~/.config/waybar/scripts/power/power-profile-cycle.sh",
        "signal": 8,
        "interval": 5,
        "format-icons": {
            "default": "",
            "performance": "",
            "balanced": "",
            "power-saver": ""
        }
    },
    "group/power": {
        "orientation": "horizontal",
        "modules": [
            "custom/power-profile",
            "battery"
        ]
    },
    "group/hardware": {
        "orientation": "horizontal",
        "modules": [
            "cpu",
            "memory"
        ]
    },
    "group/connectivity": {
        "orientation": "horizontal",
        "modules": [
            "network",
            "bluetooth"
        ]
    },
    "network": {
        "format-wifi": "<span size='13000'>󰛳 </span>{essid}",
        "format-ethernet": "<span size='13000'>󰈀 </span>Lan",
        "format-linked": "<span foreground='#6d4aff'><span size='13000'>󰖂 </span>Proton</span>",
        "format-disconnected": "󰤮 ",
        "format-disabled": "󰤮 ",
        "tooltip-format-wifi": "Signal Strength: {signalStrength}%\nIP: {ipaddr}",
        "tooltip-format-ethernet": "Interface: {ifname}\nIP: {ipaddr}",
        "tooltip-format-linked": "Proton VPN (IPv6 Leak Protection)\nInterface: {ifname}",
        "tooltip-format-disconnected": "Disconnected from network",
        "tooltip-format-disabled": "Wi-Fi is disabled",
        "on-click": "~/.config/waybar/scripts/connectivity/connectivity-toggle.sh"
    },
    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-connected": "󰂱 {device_alias}",
        "format-connected-battery": "󰂱 {device_battery_percentage}%",
        "on-click": "~/.config/waybar/scripts/connectivity/connectivity-toggle.sh",
        "format-device-preference": [
            "device1",
            "device2"
        ], // preference list deciding the displayed device
        "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%"
    },
    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": " ",
        "format-icons": {
            "headphone": "",
            "hands-free": "󰋎",
            "headset": "󰋎",
            "hdmi": "󰡁",
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },
        "on-click": "~/.config/waybar/scripts/sliders/volume-toggle.sh",
        "on-click-right": "pavucontrol"
    },
    "tray": {
        "icon-size": 15,
        "spacing": 10,
        "show-passive-items": true
    },
    "cpu": {
        "interval": 3,
        "format": "{icon} {usage}%",
        "format-alt": "{icon} {avg_frequency}GHz",
        "format-icons": [
            "󰝦",
            "󰪞",
            "󰪟",
            "󰪠",
            "󰪡",
            "󰪢",
            "󰪣",
            "󰪤",
            "󰪥"
        ],
        "states": {
            "medium": 40,
            "high": 70,
            "critical": 85
        },
        "tooltip": true,
        "tooltip-format": "CPU: {usage}%\nLoad: {load}\nFreq: {avg_frequency} GHz\n\nLeft-click: toggle format\nRight-click: open resource modal",
        "on-click-right": "~/.config/waybar/scripts/hardware/hardware-toggle.sh"
    },
    "memory": {
        "interval": 10,
        "format": "{icon} {percentage}%",
        "format-alt": "{icon} {used:0.1f}G/{total:0.1f}G",
        "format-icons": [
            "󰝦",
            "󰪞",
            "󰪟",
            "󰪠",
            "󰪡",
            "󰪢",
            "󰪣",
            "󰪤",
            "󰪥"
        ],
        "states": {
            "medium": 40,
            "high": 70,
            "critical": 85
        },
        "tooltip": true,
        "tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G ({percentage}%)\nAvailable: {avail:0.1f}G\nSwap: {swapUsed:0.1f}G / {swapTotal:0.1f}G\n\nLeft-click: toggle % / GB\nRight-click: open resource modal",
        "on-click-right": "~/.config/waybar/scripts/hardware/hardware-toggle.sh"
    }
}