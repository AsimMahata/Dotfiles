{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/ascii/arch.txt",
    "padding": {
      "top": 2,
      "right": 6
    },
    "color": {
      "1": "{{colors.primary.default.hex}}",
      "2": "{{colors.tertiary.default.hex}}"
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "{{colors.primary.default.hex}}",
      "title": "{{colors.tertiary.default.hex}}"
    }
  },
  "modules": [
    "break",
    "break",
    {
      "type": "title",
      "keyWidth": 10,
      "format": "\u001b[38;2;{{colors.tertiary.default.red}};{{colors.tertiary.default.green}};{{colors.tertiary.default.blue}};1m{user-name}\u001b[0m@\u001b[38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}m{host-name}\u001b[0m"
    },
    "break",
    {
      "type": "os",
      "format": "{name}",
      "key": " "
    },
    {
      "type": "wm",
      "format": "{process-name}",
      "key": " "
    },
    {
      "type": "uptime",
      "format": "{hours}h {minutes}m",
      "key": " "
    },
    {
      "type": "packages",
      "format": "{}",
      "key": " "
    },
    {
      "type": "cpu",
      "format": "{name}",
      "key": " "
    },
    {
      "type": "gpu",
      "format": "{name}",
      "key": " "
    },
    {
      "type": "memory",
      "key": " "
    },
    {
      "type": "media",
      "key": "󰝚 "
    },
    "break",
    {
      "key": " ",
      "type": "colors",
      "symbol": "circle"
    },
    "break",
    "break",
    "break"
  ]
}
